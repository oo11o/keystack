{
  "schemaVersion": 1,
  "stacks": [
    {
      "id": "copy-id",
      "name": "Copy Tender",
      "binding": { "code": "Digit1", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": true,
      "steps": [
        { "id": "s1", "type": "copyBySelector", "selector": "#tender_id" }
      ]
    },
    {
      "id": "sync",
      "name": "Sync",
      "binding": { "code": "Digit2", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": true,
      "steps": [
        { "id": "s1", "type": "readBySelector", "selector": "#tender_id" },
        { "id": "s2", "type": "inputToSelector", "selector": "#search", "value": "$s1" }
      ]
    },
    {
      "id": "sync-tender",
      "name": "Sync Tender",
      "binding": { "code": "Digit3", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": true,
      "steps": [
        { "id": "s1", "type": "readBySelector", "selector": "#tender_id" },
        {
          "id": "s2",
          "type": "openUrl",
          "url": "http://dzo.lh/cron/directSinhro.php?tender_id=$s1&CDB_Number=0&run=$secret_runToken&type=tenders"
        }
      ]
    },
    {
      "id": "hotkeys",
      "name": "Hotkeys",
      "binding": { "code": "Digit0", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": true,
      "steps": [
        { "id": "s1", "type": "popup", "title": "Keystack hotkeys", "body": "$stacks" }
      ]
    }
  ]
}
