{
  "schemaVersion": 1,
  "stacks": [
    {
      "id": "copy-id",
      "name": "Copy Tender",
      "binding": { "code": "Digit1", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": true,
      "steps": [
        { "id": "s1", "type": "copyBySelector", "selector": "#tender_id" }
      ]
    },
    {
      "id": "sync",
      "name": "Sync",
      "binding": { "code": "Digit2", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": true,
      "steps": [
        { "id": "s1", "type": "readBySelector", "selector": "#tender_id" },
        { "id": "s2", "type": "inputToSelector", "selector": "#search", "value": "$s1" }
      ]
    },
    {
      "id": "sync-tender-local",
      "name": "Sync Tender (local)",
      "binding": { "code": "Digit3", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": true,
      "steps": [
        { "id": "s1", "type": "readBySelector", "selector": "#tender_id" },
        {
          "id": "s2",
          "type": "openUrlInNewTab",
          "url": "http://dzo.lh/cron/directSinhro.php?tender_id=$s1&CDB_Number=0&run=$secret_runToken&type=tenders"
        }
      ]
    },
    {
      "id": "sync-tender-test",
      "name": "Sync Tender (test)",
      "binding": { "code": "Digit4", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": true,
      "steps": [
        { "id": "s1", "type": "readBySelector", "selector": "#tender_id" },
        {
          "id": "s2",
          "type": "openUrlInNewTab",
          "url": "https://test.dzo.com.ua/cron/directSinhro.php?tender_id=$s1&CDB_Number=0&run=$secret_runToken&type=tenders"
        }
      ]
    },
    {
      "id": "sync-tender-stage",
      "name": "Sync Tender (stage)",
      "binding": { "code": "Digit5", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": true,
      "steps": [
        { "id": "s1", "type": "readBySelector", "selector": "#tender_id" },
        {
          "id": "s2",
          "type": "openUrlInNewTab",
          "url": "https://stage.dzo.com.ua/cron/directSinhro.php?tender_id=$s1&CDB_Number=0&run=$secret_runToken&type=tenders"
        }
      ]
    },
    {
      "id": "sync-tender-local-fetch",
      "name": "Sync Tender (local, fetch)",
      "binding": { "code": "Digit6", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": true,
      "steps": [
        { "id": "s1", "type": "readBySelector", "selector": "#tender_id" },
        {
          "id": "s2",
          "type": "fetchUrl",
          "url": "http://dzo.lh/cron/directSinhro.php?tender_id=$s1&CDB_Number=0&run=$secret_runToken&type=tenders",
          "saveAs": "syncResult"
        },
        { "id": "s3", "type": "popup", "title": "Sync result", "body": "$syncResult" }
      ]
    },
    {
      "id": "show-prozorro-tender",
      "name": "Show Prozorro Tender",
      "binding": { "code": "Digit7", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": true,
      "steps": [
        { "id": "s1", "type": "readBySelector", "selector": "#tender_id" },
        {
          "id": "s2",
          "type": "fetchUrl",
          "url": "https://public-api-staging.prozorro.gov.ua/api/2.5/tenders/$s1?opt_pretty=1",
          "saveAs": "tender"
        },
        { "id": "s3", "type": "popupJson", "title": "Prozorro Tender", "body": "$tender" }
      ]
    },
    {
      "id": "logout",
      "name": "Logout",
      "binding": { "code": "Digit8", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": true,
      "steps": [
        { "id": "s1", "type": "openUrlInCurrentTab", "url": "http://dzo.lh/cabinet/logout" },
        { "id": "s2", "type": "openUrlInCurrentTab", "url": "http://dzo.lh/tenders/new" },
        {
          "id": "s3",
          "type": "inputToSelector",
          "selector": "[name=\"email\"]",
          "value": "buyer_test@dzo.com.ua"
        }
      ]
    },
    {
      "id": "hotkeys",
      "name": "Hotkeys",
      "binding": { "code": "Digit0", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": true,
      "steps": [
        { "id": "s1", "type": "popup", "title": "Keystack hotkeys", "body": "$stacks" }
      ]
    }
  ]
}
